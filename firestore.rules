// SGA — Last updated: Added explicit rule for /notifications collection (Bug 2 fix) — previously fell under the default-deny catch-all, causing "Failed to save quotation" errors for manual-vehicle-entry quotations even though the quotation itself saved successfully
// firestore.rules — SHREE GANESH AUTOMOBILE — PRODUCTION SECURITY RULES
// Version: 1.3 | Post-Launch Fix
//
// ── CHANGES FROM v1.1 ────────────────────────────────────────────────────
//   FIX 4 — /inventory/{itemId}/restockHistory subcollection had NO rule.
//            Firestore rules do NOT cascade from a parent document to its
//            subcollections — each must be explicitly declared.
//            Without this rule, getRestockHistory() failed in production
//            with a permission-denied error (catch-all DENY ALL applied).
//            The error was caught by the store, but because fetchItem()
//            could also fail for network/timing reasons and the
//            ItemDetailPage had no error state handling, any failure left
//            the page stuck on "Loading item..." indefinitely.
//            Fix: added explicit rule for the subcollection (all staff read,
//            Owner+ write — matches the parent inventory permission model).
//
// ── ROLES (stored as custom claims on Firebase Auth tokens) ──────────────
//   superadmin  → God-mode. Manages users, backups, car repo, system config.
//   owner       → Full business access. Cannot touch system config.
//   employee    → Limited: create pending invoices, view customers/inventory.
//   (accountant → placeholder, not implemented in v1)
//
// ── AUDIT CHECKLIST ──────────────────────────────────────────────────────
//   [✓] Employees cannot read quotations
//   [✓] Employees cannot read messaging/conversations
//   [✓] Employees cannot read financial reports
//   [✓] Invoice DB lock (systemConfig.invoiceDbLocked) enforced at rule level
//   [✓] AuditLog: append-only for Owner/Employee; SuperAdmin can delete only
//   [✓] SuperAdmin cannot be locked out of systemConfig
//   [✓] Users can only modify their own theme/language preferences
//   [✓] Car repository: write restricted to superadmin only
//   [✓] No sensitive data accessible to unauthenticated requests
//   [✓] followUpTemplates: Owner+ read/write (was missing — caused loading loop)
//   [✓] inventory/restockHistory subcollection: explicitly covered (v1.2)
// ─────────────────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ──────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }
    function isSuperAdmin() {
      return isAuth() && role() == 'superadmin';
    }
    function isOwner() {
      return isAuth() && role() == 'owner';
    }
    function isEmployee() {
      return isAuth() && role() == 'employee';
    }
    function isOwnerOrAbove() {
      return isSuperAdmin() || isOwner();
    }
    function isAnyStaff() {
      return isSuperAdmin() || isOwner() || isEmployee();
    }

    function invoiceDbLocked() {
      // FIX: Use exists() guard before accessing .data.
      // If systemConfig/main does not exist yet, get() returns null and
      // null.data throws a NullPointerException in rule evaluation which
      // DENIES the request. This caused Owner (not SuperAdmin — whose rule
      // short-circuits) to be denied invoice reads entirely, which made ALL
      // dashboard stats show 0 because the fetch aborted on the first query.
      return exists(/databases/$(database)/documents/systemConfig/main) &&
        get(/databases/$(database)/documents/systemConfig/main).data.invoiceDbLocked == true;
    }

    function isSelf(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function onlyUpdating(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ──────────────────────────────────────────────────────────
    // /users — User management
    // ──────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isSuperAdmin() || isSelf(userId);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin()
                    || (isSelf(userId) && onlyUpdating(['theme', 'language', 'fcmTokens']));
      allow delete: if isSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────
    // /customers — Customer records
    // ──────────────────────────────────────────────────────────
    match /customers/{customerId} {
      allow read:   if isAnyStaff();
      allow create: if isAnyStaff();
      allow update: if isOwnerOrAbove()
                    || (isEmployee() && onlyUpdating([
                         'name', 'phone', 'altPhone', 'vehicleNo',
                         'vehicleCompany', 'vehicleModel', 'vehicleYear',
                         'emissionCategory', 'cngKitBrand', 'cngKitModel',
                         'tankCapacity', 'advancers', 'addOns',
                         'installDate', 'technicianName', 'customFields'
                       ]));
      allow delete: if isOwnerOrAbove();
    }

    // ──────────────────────────────────────────────────────────
    // /invoices — Invoice records
    // ──────────────────────────────────────────────────────────
    match /invoices/{invoiceId} {
      allow read: if isSuperAdmin()
                  || (!invoiceDbLocked() && isAnyStaff());
      allow create: if isOwnerOrAbove()
                    || (isEmployee() && request.resource.data.status == 'PENDING');
      allow update: if isOwnerOrAbove() && !invoiceDbLocked();
      allow delete: if isOwnerOrAbove() && !invoiceDbLocked();
    }

    // ──────────────────────────────────────────────────────────
    // /inventory — Inventory items + restockHistory subcollection
    // FIX v1.2: Added explicit rule for restockHistory subcollection.
    // Firestore rules do NOT inherit from the parent match block.
    // Without this, getRestockHistory() was denied in production.
    // ──────────────────────────────────────────────────────────
    match /inventory/{itemId} {
      allow read:           if isAnyStaff();
      allow create, update: if isOwnerOrAbove();
      allow delete:         if isOwnerOrAbove();

      // Restock history subcollection — all staff can read,
      // only Owner+ can write (same model as parent inventory doc).
      match /restockHistory/{historyId} {
        allow read:   if isAnyStaff();
        allow create: if isOwnerOrAbove();
        allow update: if isSuperAdmin();   // effectively immutable; SA only for data correction
        allow delete: if isSuperAdmin();   // SA can clean up duplicate entries if needed
      }
    }

    // ──────────────────────────────────────────────────────────
    // /quotations — Quotation records
    // ──────────────────────────────────────────────────────────
    match /quotations/{quotationId} {
      allow read:             if isOwnerOrAbove();
      allow create, update:   if isOwnerOrAbove();
      allow delete:           if isOwnerOrAbove();
    }

    // ──────────────────────────────────────────────────────────
    // /auditLog — Audit trail
    // ──────────────────────────────────────────────────────────
    match /auditLog/{logId} {
      allow read:   if isOwnerOrAbove();
      allow create: if isAnyStaff();
      allow delete: if isSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────
    // /followUps — Follow-up schedules
    // ──────────────────────────────────────────────────────────
    match /followUps/{followUpId} {
      allow read, write: if isOwnerOrAbove();
    }

    // ──────────────────────────────────────────────────────────
    // /followUpTemplates — Follow-up message templates (EN/HI/GU)
    // ──────────────────────────────────────────────────────────
    match /followUpTemplates/{templateId} {
      allow read:           if isOwnerOrAbove();
      allow create, update: if isOwnerOrAbove();
      allow delete:         if isOwnerOrAbove();
    }

    // ──────────────────────────────────────────────────────────
    // /conversations — Unified messaging inbox
    // ──────────────────────────────────────────────────────────
    match /conversations/{conversationId} {
      allow read, write: if isOwnerOrAbove();

      match /notes/{noteId} {
        allow read, write: if isOwnerOrAbove();
      }
    }

    // ──────────────────────────────────────────────────────────
    // /carRepository — Car company/model/media link tree
    // ──────────────────────────────────────────────────────────
    match /carRepository/{docId} {
      allow read:                    if isAnyStaff();
      allow create, update, delete:  if isSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────
    // /docsRepository — Business documents
    // ──────────────────────────────────────────────────────────
    match /docsRepository/{docId} {
      allow read:           if isAnyStaff();
      allow create, update: if isOwnerOrAbove();
      allow delete:         if isOwnerOrAbove();
    }

    // ──────────────────────────────────────────────────────────
    // /settings — Business settings
    // ──────────────────────────────────────────────────────────
    match /settings/{settingId} {
      allow read:           if isAnyStaff();
      allow create, update: if isOwnerOrAbove();
      allow delete:         if isSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────
    // /reminderLog — CNG re-test reminder tracking
    // ──────────────────────────────────────────────────────────
    match /reminderLog/{reminderId} {
      allow read:   if isOwnerOrAbove();
      allow create: if isOwnerOrAbove();
      allow update: if isOwnerOrAbove();
      allow delete: if isSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────
    // /systemConfig — SuperAdmin control flags
    // ──────────────────────────────────────────────────────────
    match /systemConfig/{configId} {
      allow read:           if isAnyStaff();
      allow create, update: if isSuperAdmin();
      allow delete:         if isSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────
    // /messageTemplates — Follow-up message templates (legacy name)
    // ──────────────────────────────────────────────────────────
    match /messageTemplates/{templateId} {
      allow read:           if isOwnerOrAbove();
      allow create, update: if isOwnerOrAbove();
      allow delete:         if isOwnerOrAbove();
    }

    // ──────────────────────────────────────────────────────────
    // /notifications — SuperAdmin alerts (e.g. car model not in
    // Car Repository, used during Quotation creation)
    // ──────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read:   if isOwnerOrAbove();
      allow create: if isOwnerOrAbove();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────
    // DENY ALL OTHER PATHS BY DEFAULT
    // ──────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}