// SGA — Last updated: Bug Fix — Added /docsCategories rule (was missing — caused "Missing or
// insufficient permissions" for Owner/SuperAdmin when creating categories in Docs Repository).
// Added /docsFolders rule for new nested folder structure in Docs Repository redesign.
// Added /quotationPriceTables rule for new Manage Quotations price table feature.
// firestore.rules — SHREE GANESH AUTOMOBILE — PRODUCTION SECURITY RULES
// Version: 1.4 | Docs Category Bug Fix + Quotation Tables + Nested Folders
//
// ── CHANGES FROM v1.3 ────────────────────────────────────────────────────
//   BUG FIX — /docsCategories had NO rule in v1.3.
//             useDocsRepository.js stores categories in the "docsCategories"
//             collection, but firestore.rules only had a rule for
//             "docsRepository". The catch-all DENY ALL block then silently
//             denied every read and write to "docsCategories" for ALL roles,
//             including Owner and SuperAdmin. This produced the
//             "Missing or insufficient permissions" error shown in the UI
//             whenever the CategoryManager tried to load or create categories.
//             Fix: added explicit rule for /docsCategories/{docId} mirroring
//             the same access model as /docsRepository (Owner+ read/write,
//             all staff read).
//
//   NEW — /docsFolders collection for hierarchical nested folder structure
//         in Docs Repository. Owner+ can create, rename, delete folders.
//         All staff can read (needed to navigate folder tree).
//
//   NEW — /quotationPriceTables collection for Manage Quotations price
//         table feature. Owner+ read/write. Superadmin can delete.
//
// ── ROLES (stored as custom claims on Firebase Auth tokens) ──────────────
//   superadmin  → God-mode. Manages users, backups, car repo, system config.
//   owner       → Full business access. Cannot touch system config.
//   employee    → Limited: create pending invoices, view customers/inventory.
//   (accountant → placeholder, not implemented in v1)
//
// ── AUDIT CHECKLIST ──────────────────────────────────────────────────────
//   [✓] Employees cannot read quotations
//   [✓] Employees cannot read messaging/conversations
//   [✓] Employees cannot read financial reports
//   [✓] Invoice DB lock (systemConfig.invoiceDbLocked) enforced at rule level
//   [✓] AuditLog: append-only for Owner/Employee; SuperAdmin can delete only
//   [✓] SuperAdmin cannot be locked out of systemConfig
//   [✓] Users can only modify their own theme/language preferences
//   [✓] Car repository: write restricted to superadmin only
//   [✓] No sensitive data accessible to unauthenticated requests
//   [✓] followUpTemplates: Owner+ read/write
//   [✓] inventory/restockHistory subcollection: explicitly covered (v1.2)
//   [✓] docsCategories: Owner+ read/write (v1.4 — BUG FIX)
//   [✓] docsFolders: Owner+ read/write, all staff read (v1.4)
//   [✓] quotationPriceTables: Owner+ read/write (v1.4)
// ─────────────────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ──────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }
    function isSuperAdmin() {
      return isAuth() && role() == 'superadmin';
    }
    function isOwner() {
      return isAuth() && role() == 'owner';
    }
    function isEmployee() {
      return isAuth() && role() == 'employee';
    }
    function isOwnerOrAbove() {
      return isSuperAdmin() || isOwner();
    }
    function isAnyStaff() {
      return isSuperAdmin() || isOwner() || isEmployee();
    }

    function invoiceDbLocked() {
      return exists(/databases/$(database)/documents/systemConfig/main) &&
        get(/databases/$(database)/documents/systemConfig/main).data.invoiceDbLocked == true;
    }

    function isSelf(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function onlyUpdating(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ──────────────────────────────────────────────────────────
    // /users — User management
    // ──────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isSuperAdmin() || isSelf(userId);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin()
                    || (isSelf(userId) && onlyUpdating(['theme', 'language', 'fcmTokens']));
      allow delete: if isSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────
    // /customers — Customer records
    // ──────────────────────────────────────────────────────────
    match /customers/{customerId} {
      allow read:   if isAnyStaff();
      allow create: if isAnyStaff();
      allow update: if isOwnerOrAbove()
                    || (isEmployee() && onlyUpdating([
                         'name', 'phone', 'altPhone', 'vehicleNo',
                         'vehicleCompany', 'vehicleModel', 'vehicleYear',
                         'emissionCategory', 'cngKitBrand', 'cngKitModel',
                         'tankCapacity', 'advancers', 'addOns',
                         'installDate', 'technicianName', 'customFields'
                       ]));
      allow delete: if isOwnerOrAbove();
    }

    // ──────────────────────────────────────────────────────────
    // /invoices — Invoice records
    // ──────────────────────────────────────────────────────────
    match /invoices/{invoiceId} {
      allow read: if isSuperAdmin()
                  || (!invoiceDbLocked() && isAnyStaff());
      allow create: if isOwnerOrAbove()
                    || (isEmployee() && request.resource.data.status == 'PENDING');
      allow update: if isOwnerOrAbove() && !invoiceDbLocked();
      allow delete: if isOwnerOrAbove() && !invoiceDbLocked();
    }

    // ──────────────────────────────────────────────────────────
    // /inventory — Inventory items + restockHistory subcollection
    // ──────────────────────────────────────────────────────────
    match /inventory/{itemId} {
      allow read:           if isAnyStaff();
      allow create, update: if isOwnerOrAbove();
      allow delete:         if isOwnerOrAbove();

      match /restockHistory/{historyId} {
        allow read:   if isAnyStaff();
        allow create: if isOwnerOrAbove();
        allow update: if isSuperAdmin();
        allow delete: if isSuperAdmin();
      }
    }

    // ──────────────────────────────────────────────────────────
    // /quotations — Quotation records
    // ──────────────────────────────────────────────────────────
    match /quotations/{quotationId} {
      allow read:             if isOwnerOrAbove();
      allow create, update:   if isOwnerOrAbove();
      allow delete:           if isOwnerOrAbove();
    }

    // ──────────────────────────────────────────────────────────
    // /quotationPriceTables — Price tables for Manage Quotations
    // NEW in v1.4: stores Kit, Advancer, Extras, Cylinder pricing
    // for BS4 / BS6-4INJ / BS6-8INJ emission categories.
    // Document IDs: "BS4", "BS6_4INJ", "BS6_8INJ"
    // ──────────────────────────────────────────────────────────
    match /quotationPriceTables/{tableId} {
      allow read:             if isOwnerOrAbove();
      allow create, update:   if isOwnerOrAbove();
      allow delete:           if isSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────
    // /auditLog — Audit trail
    // ──────────────────────────────────────────────────────────
    match /auditLog/{logId} {
      allow read:   if isOwnerOrAbove();
      allow create: if isAnyStaff();
      allow delete: if isSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────
    // /followUps — Follow-up schedules
    // ──────────────────────────────────────────────────────────
    match /followUps/{followUpId} {
      allow read, write: if isOwnerOrAbove();
    }

    // ──────────────────────────────────────────────────────────
    // /followUpTemplates — Follow-up message templates
    // ──────────────────────────────────────────────────────────
    match /followUpTemplates/{templateId} {
      allow read:           if isOwnerOrAbove();
      allow create, update: if isOwnerOrAbove();
      allow delete:         if isOwnerOrAbove();
    }

    // ──────────────────────────────────────────────────────────
    // /conversations — Unified messaging inbox
    // ──────────────────────────────────────────────────────────
    match /conversations/{conversationId} {
      allow read, write: if isOwnerOrAbove();

      match /notes/{noteId} {
        allow read, write: if isOwnerOrAbove();
      }
    }

    // ──────────────────────────────────────────────────────────
    // /carRepository — Car company/model/media link tree
    // ──────────────────────────────────────────────────────────
    match /carRepository/{docId} {
      allow read:                    if isAnyStaff();
      allow create, update, delete:  if isSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────
    // /docsRepository — Business document records
    // ──────────────────────────────────────────────────────────
    match /docsRepository/{docId} {
      allow read:           if isAnyStaff();
      allow create, update: if isOwnerOrAbove();
      allow delete:         if isOwnerOrAbove();
    }

    // ──────────────────────────────────────────────────────────
    // /docsCategories — Flat category labels for Docs Repository
    // BUG FIX v1.4: This collection was MISSING from the rules.
    // useDocsRepository.js stores categories here (collection name
    // "docsCategories"). Without this rule, the catch-all DENY ALL
    // blocked every read/write, including Owner and SuperAdmin —
    // causing the "Missing or insufficient permissions" error in
    // the CategoryManager modal.
    // ──────────────────────────────────────────────────────────
    match /docsCategories/{categoryId} {
      allow read:           if isAnyStaff();
      allow create, update: if isOwnerOrAbove();
      allow delete:         if isOwnerOrAbove();
    }

    // ──────────────────────────────────────────────────────────
    // /docsFolders — Nested folder hierarchy for Docs Repository
    // NEW in v1.4: enables Windows Explorer-style folder tree.
    // parentId: null for root folders, folderId string for nested.
    // All staff can read to navigate the tree.
    // Owner+ can create, rename, delete folders.
    // ──────────────────────────────────────────────────────────
    match /docsFolders/{folderId} {
      allow read:           if isAnyStaff();
      allow create, update: if isOwnerOrAbove();
      allow delete:         if isOwnerOrAbove();
    }

    // ──────────────────────────────────────────────────────────
    // /settings — Business settings
    // ──────────────────────────────────────────────────────────
    match /settings/{settingId} {
      allow read:           if isAnyStaff();
      allow create, update: if isOwnerOrAbove();
      allow delete:         if isSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────
    // /reminderLog — CNG re-test reminder tracking
    // ──────────────────────────────────────────────────────────
    match /reminderLog/{reminderId} {
      allow read:   if isOwnerOrAbove();
      allow create: if isOwnerOrAbove();
      allow update: if isOwnerOrAbove();
      allow delete: if isSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────
    // /systemConfig — SuperAdmin control flags
    // ──────────────────────────────────────────────────────────
    match /systemConfig/{configId} {
      allow read:           if isAnyStaff();
      allow create, update: if isSuperAdmin();
      allow delete:         if isSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────
    // /messageTemplates — Follow-up message templates (legacy)
    // ──────────────────────────────────────────────────────────
    match /messageTemplates/{templateId} {
      allow read:           if isOwnerOrAbove();
      allow create, update: if isOwnerOrAbove();
      allow delete:         if isOwnerOrAbove();
    }

    // ──────────────────────────────────────────────────────────
    // /notifications — SuperAdmin alerts
    // ──────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read:   if isOwnerOrAbove();
      allow create: if isOwnerOrAbove();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────
    // DENY ALL OTHER PATHS BY DEFAULT
    // ──────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}