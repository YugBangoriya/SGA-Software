# ─────────────────────────────────────────────────────────────────────────────
# Shree Ganesh Automobile — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git — it's already in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase Web App Config ───────────────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=your-firebase-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ── Firebase Cloud Messaging (FCM) — for push notifications ──────────────────
# Get from: Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=your-vapid-key-here

# ── WhatsApp Business API (Meta Cloud API) ────────────────────────────────────
# Get from: developers.facebook.com → Your App → WhatsApp → API Setup
VITE_WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
VITE_WHATSAPP_WABA_ID=your-whatsapp-business-account-id

# ── Google Cloud Translation API (optional — for auto-translate) ──────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials
VITE_GOOGLE_TRANSLATE_API_KEY=your-translate-api-key

# ─────────────────────────────────────────────────────────────────────────────
# NOTE: WhatsApp Access Token and Meta Page Access Token are stored as
# Firebase Functions environment config (NOT here), set via:
#   firebase functions:config:set whatsapp.access_token="YOUR_TOKEN"
#   firebase functions:config:set meta.page_access_token="YOUR_TOKEN"
#   firebase functions:config:set meta.verify_token="YOUR_WEBHOOK_TOKEN"
# ─────────────────────────────────────────────────────────────────────────────
