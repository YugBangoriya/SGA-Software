    "deploy": "firebase deploy --only functions",
    "logs":   "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "type": "commonjs",
  "main": "src/index.js",
  "dependencies": {
    "axios":              "^1.7.2",
    "firebase-admin":     "^12.2.0",
    "firebase-functions": "^7.2.5",
    "jszip":              "^3.10.1",
    "node-fetch":         "^2.7.0",
    "pdfkit":             "^0.15.0"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.3.0",
    "eslint":                  "^8.15.0"
  },
  "private": true
}