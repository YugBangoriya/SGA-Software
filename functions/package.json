{
  "name": "shree-ganesh-automobile-functions",
  "description": "Firebase Cloud Functions — Shree Ganesh Automobile Business Management PWA (All Phases Merged)",
  "scripts": {
    "serve":  "firebase emulators:start --only functions",
    "shell":  "firebase functions:shell",
