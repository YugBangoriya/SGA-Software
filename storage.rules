// SGA — Last updated: Added explicit rules for business/logo, invoices, quotations paths; fixed storage/unauthorized error on logo upload
//
// ─────────────────────────────────────────────────────────
//  storage.rules — COMPLETE & AUTHORITATIVE FILE
//  Shree Ganesh Automobile — Firebase Storage Security Rules
// ─────────────────────────────────────────────────────────

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Helper functions ─────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function getRole() {
      return request.auth.token.role;
    }

    function isSuperAdmin() {
      return isAuthenticated() && getRole() == 'superadmin';
    }

    function isOwner() {
      return isAuthenticated() && getRole() == 'owner';
    }

    function isOwnerOrSuperAdmin() {
      return isSuperAdmin() || isOwner();
    }

    function isEmployee() {
      return isAuthenticated() && getRole() == 'employee';
    }

    function isAnyValidRole() {
      return isOwnerOrSuperAdmin() || isEmployee();
    }

    // ─────────────────────────────────────────────────────
    //  business/logo — Business logo used in PDF headers
    //
    //  READ:   All authenticated users
    //          (logo appears in invoice/quotation PDFs for all)
    //  WRITE:  SuperAdmin + Owner only
    //  DELETE: SuperAdmin + Owner only
    //  Max:    2 MB
    //  Types:  PNG, JPG, SVG, WebP
    // ─────────────────────────────────────────────────────
    match /business/logo {
      allow read:   if isAuthenticated();

      allow write:  if isOwnerOrSuperAdmin()
                    && request.resource.size <= 2097152   // 2 MB
                    && request.resource.contentType.matches('image/.*');

      allow delete: if isOwnerOrSuperAdmin();
    }

    // Also allow any path under /business/ for future assets (favicon, banner, etc.)
    match /business/{allPaths=**} {
      allow read:   if isAuthenticated();

      allow write:  if isOwnerOrSuperAdmin()
                    && request.resource.size <= 5242880   // 5 MB
                    && request.resource.contentType.matches('image/.*');

      allow delete: if isOwnerOrSuperAdmin();
    }

    // ─────────────────────────────────────────────────────
    //  invoices/** — Generated invoice PDFs
    //
    //  READ:   SuperAdmin + Owner + Employee
    //  WRITE:  SuperAdmin + Owner (Cloud Functions also write here)
    //  DELETE: SuperAdmin only (monthly backup workflow)
    // ─────────────────────────────────────────────────────
    match /invoices/{allPaths=**} {
      allow read:   if isAnyValidRole();

      allow write:  if isOwnerOrSuperAdmin()
                    && request.resource.size <= 10485760  // 10 MB
                    && request.resource.contentType.matches('application/pdf');

      allow delete: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────────────
    //  quotations/** — Generated quotation PDFs
    //
    //  READ:   SuperAdmin + Owner
    //  WRITE:  SuperAdmin + Owner
    //  DELETE: SuperAdmin + Owner
    // ─────────────────────────────────────────────────────
    match /quotations/{allPaths=**} {
      allow read:   if isOwnerOrSuperAdmin();

      allow write:  if isOwnerOrSuperAdmin()
                    && request.resource.size <= 10485760  // 10 MB
                    && request.resource.contentType.matches('application/pdf');

      allow delete: if isOwnerOrSuperAdmin();
    }

    // ─────────────────────────────────────────────────────
    //  docsRepository/** — Price lists, banners, business cards
    //
    //  READ:   SuperAdmin + Owner only
    //  WRITE:  SuperAdmin + Owner only
    //  DELETE: SuperAdmin + Owner only
    //  Max:    50 MB
    // ─────────────────────────────────────────────────────
    match /docsRepository/{allPaths=**} {
      allow read:   if isOwnerOrSuperAdmin();

      allow write:  if isOwnerOrSuperAdmin()
                    && request.resource.size <= 52428800  // 50 MB
                    && (
                      request.resource.contentType.matches('application/pdf')
                      || request.resource.contentType.matches('image/.*')
                      || request.resource.contentType.matches('video/mp4')
                      || request.resource.contentType.matches('video/quicktime')
                      || request.resource.contentType.matches('video/webm')
                      || request.resource.contentType.matches('application/msword')
                      || request.resource.contentType.matches(
                           'application/vnd.openxmlformats-officedocument.wordprocessingml.document')
                      || request.resource.contentType.matches('application/vnd.ms-excel')
                      || request.resource.contentType.matches(
                           'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')
                      || request.resource.contentType.matches('text/csv')
                    );

      allow delete: if isOwnerOrSuperAdmin();
    }

    // ─────────────────────────────────────────────────────
    //  Deny everything else by default
    // ─────────────────────────────────────────────────────
    match /{everythingElse=**} {
      allow read, write: if false;
    }

  }
}